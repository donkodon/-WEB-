# withoutBG Background Removal Server Configuration
# Deployed on Hugging Face Space: https://jinkedon-withoutbg-api.hf.space
# This is a FALLBACK server - Primary service is Cloudflare AI Workers

# Port (default: 8001 for withoutBG)
PORT=8001

# CORS Allowed Origins (comma-separated)
# ✅ PRODUCTION: Specify exact domains (no wildcard)
# ❌ NEVER use "*" in production
ALLOWED_ORIGINS=https://smart-measure.pages.dev,https://smart-measure-production.pages.dev,http://localhost:3000,http://127.0.0.1:3000

# Example for development (allow all):
# ALLOWED_ORIGINS=*

# Example for specific domains:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
